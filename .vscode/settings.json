{
    "dotnet.defaultSolution": "acme.sln",
    "dotnet.automaticRestore": true,
    "editor.formatOnSave": true,
    "files.insertFinalNewline": false,
    "files.eol": "\n",
    "[markdown]": {
        "files.trimTrailingWhitespace": false
    },
    "files.exclude": {
        "**/.vshistory": true,
        "**/bin": true,
        "**/obj": true
    },
    "search.exclude": {
        "**/.vshistory": true,
        "**/bin": true,
        "**/obj": true
    }
}